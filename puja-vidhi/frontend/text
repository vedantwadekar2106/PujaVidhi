<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<script src="https://cdn.tailwindcss.com"></script>
<title>Puja Vidhi | Sacred Rituals</title>
<style>
  /* custom overrides + mobile enhancements */
  body {
    margin: 0;
    font-family: system-ui, 'Segoe UI', 'Roboto', sans-serif;
    background: url("background2.jpg") no-repeat center center fixed;
    background-size: cover;
    min-height: 100vh;
  }

  /* glassmorphism refinements */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255,255,255,0.3);
  }

  .card {
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(8px);
    border-radius: 1.25rem;
    overflow: hidden;
    transition: all 0.25s ease;
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
  }
  .card:hover {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.75);
    box-shadow: 0 20px 25px -12px rgba(0,0,0,0.2);
  }
  .card-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }
  .footer {
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255,255,240,0.5);
    margin-top: 2rem;
  }
  .logo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255,215,0,0.5);
  }
  .brand {
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.3px;
    background: linear-gradient(135deg, #b45309, #92400e);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    text-shadow: 0 1px 2px rgba(255,215,0,0.2);
  }
  /* language select & signup button */
  .lang-select {
    background: rgba(255,255,245,0.8);
    border-radius: 40px;
    padding: 6px 12px;
    font-weight: 500;
    border: 1px solid rgba(0,0,0,0.1);
    font-size: 0.85rem;
    cursor: pointer;
  }
  .btn-sign {
    background: rgba(230, 126, 34, 0.9);
    color: white;
    padding: 6px 14px;
    border-radius: 40px;
    font-weight: 600;
    border: none;
    backdrop-filter: blur(4px);
    transition: 0.2s;
    cursor: pointer;
  }
  .btn-sign:hover {
    background: #d97706;
    transform: scale(0.97);
  }
  /* mobile first navbar adjustments */
  @media (max-width: 680px) {
    .nav-container {
      flex-direction: column;
      gap: 10px;
      padding: 10px 12px;
    }
    .nav-menu {
      flex-wrap: wrap;
      justify-content: center;
      gap: 15px 20px;
    }
    .nav-right {
      flex-wrap: wrap;
      justify-content: center;
    }
    .brand {
      font-size: 1.2rem;
    }
    .card-img {
      height: 160px;
    }
    .footer .flex.flex-wrap {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .footer .w-1\/2 {
      width: 100%;
      text-align: center;
    }
  }
  /* smoother grid on tablets */
  @media (min-width: 640px) and (max-width: 768px) {
    .grid {
      gap: 1.25rem;
    }
  }
  .popup-content {
    text-align: center;
    padding: 1.5rem;
  }
  .om-text {
    color: #ffd966;
    font-size: 3rem;
    font-weight: bold;
    font-family: 'Segoe UI', system-ui;
    animation: zoomGlow 3s ease-in-out;
    display: inline-block;
  }
  @keyframes zoomGlow {
    0% { transform: scale(0.4); opacity: 0; text-shadow: 0 0 0px gold;}
    40% { transform: scale(1.2); opacity: 1; text-shadow: 0 0 20px #ffaa33, 0 0 40px #ff8800;}
    100% { transform: scale(1); text-shadow: 0 0 8px #ffcc66;}
  }
  #popup {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle, rgba(0,0,0,0.95), #1a0f00);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.9s cubic-bezier(0.2, 0.9, 0.4, 1.1);
  }
  #popup.show {
    opacity: 1;
    visibility: visible;
  }
  #popup.hide {
    opacity: 0;
    visibility: hidden;
  }
  .footer-title {
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 10px;
    color: #2d2a24;
    border-left: 3px solid #e67e22;
    padding-left: 8px;
    display: inline-block;
  }
  .footer p, .footer div p {
    margin: 5px 0;
    font-size: 0.85rem;
    color: #2c2c2c;
  }
  .nav-menu a {
    font-weight: 500;
    transition: 0.2s;
    padding: 4px 0;
    border-bottom: 2px solid transparent;
  }
  .nav-menu a:hover {
    border-bottom-color: #e67e22;
    color: #b45309;
  }
  .card-body {
    padding: 1rem;
  }
  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 6px;
    color: #7b341e;
  }
</style>
</head>
<body>

<!-- 🔱 SACRED POPUP -->
<div id="popup">
