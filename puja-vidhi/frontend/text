    </div>
    <div class="border-t border-amber-200/40 mt-10 pt-6 text-center text-xs text-stone-700">
      © 2025 Puja Vidhi — सत्यं शिवं सुन्दरम्
    </div>
  </div>
</footer>
<script src="js/app.js"></script>

</body>
</html>

fetch("http://localhost:5000/api/bhakti")
  .then(res => res.json())
  .then(data => {
    const container = document.getElementById("bhakti-container");

    data.forEach(item => {
      const div = document.createElement("div");

      div.innerHTML = `
        <h3>${item.title}</h3>
        <p>${item.category}</p>
        <p>${item.content}</p>
      `;

      container.appendChild(div);
    });
